import { useEffect, useState } from 'react';
import { Link } from 'react-router-dom';
import Snap from 'lenis/snap';
import { useLenis } from '@/components/common/SmoothScroll';
import Hero from '@/components/sections/Hero';
import Media from '@/components/common/Media';
import { postsService } from '@/services/cms.service';
import { storage } from '@/services/storage';
import { useSiteSettings } from '@/hooks/useSiteSettings';
import type { Post } from '@/types';
import CountUp from '@/components/common/CountUp';
import TextTrack from '@/components/common/TextTrack';
import ProgramLadder from '@/components/sections/ProgramLadder';
import PrincipalMessage from '@/components/sections/PrincipalMessage';
import FuturisticElement from '@/components/common/FuturisticElement';

/** Reads as "12 March 2026" — spelled out, the way a school circular dates itself. */
const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const CATEGORY_LABEL: Record<Post['category'], string> = {
  news: 'News',
  event: 'Event',
  announcement: 'Circular',
};

/**
 * Facts about the school, separated by rules rather than boxed into cards.
 * Static because they are the institution's constants — a founding year and
 * an acreage don't belong in a CMS field that can drift out of date.
 */
const GLANCE = [
  { value: '1981', label: 'Founded in Al Muladha' },
  { value: '2,200', label: 'Students enrolled' },
  { value: '16', label: 'Acres of campus' },
  { value: 'KG–12', label: 'One continuous CBSE curriculum' },
];

function usePublishedPosts() {
  const [posts, setPosts] = useState<Post[]>(() => postsService.listPublished());
  useEffect(() => {
    const refresh = () => setPosts(postsService.listPublished());
    refresh();
    return storage.subscribe(refresh);
  }, []);
  return posts;
}

/**
 * Settles the page on one `.snap-section` at a time, driven by Lenis so the
 * snap glides with the same easing as ordinary wheel scrolling. (CSS
 * `scroll-snap` is deliberately not used: on <html> it fights Lenis's
 * per-frame scroll writes and makes the page stick.)
 *
 * `proximity`, not `mandatory`: a section taller than the viewport (a phone,
 * a long news grid) stays freely scrollable in its middle, and the footer
 * below the last section stays reachable. The snap only engages once the
 * reader stops within reach of a section's top edge. Scoped to this route by
 * living in Home's effect — every other page scrolls normally.
 *
 * `dep` re-registers the sections when CMS-driven ones appear or disappear.
 * Under reduced motion there's no Lenis instance, so nothing snaps.
 */
function useSectionSnap(dep: unknown) {
  const lenis = useLenis();

  useEffect(() => {
    if (!lenis) return;

    const snap = new Snap(lenis, {
      type: 'proximity',
      distanceThreshold: '40%',
      debounce: 120,
      duration: 1.1,
      easing: (t: number) => 1 - Math.pow(1 - t, 4),
    });
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.snap-section'));
    snap.addElements(sections, { align: ['start'] });

    return () => snap.destroy();
  }, [lenis, dep]);
}

export default function Home() {
  const { settings } = useSiteSettings();
  const posts = usePublishedPosts();
  useSectionSnap(`${posts.length}:${settings.k12Programs.length}`);

  const lead = posts.slice(0, 3);
  const notices = posts.slice(3, 9);

  return (
    <>
      <Hero />

      {/* ------------------------------------------------------------ at a glance
          Evolved from a static watermark to a dynamic, immersive experience.
          Oversized text tracks move in the opposite direction of scroll,
          while stats count up on entrance. */}
      <section className="snap-section relative flex flex-col justify-center overflow-hidden bg-paper">
        <div className="absolute inset-0 z-0 pointer-events-none flex flex-col justify-center gap-20 opacity-[0.03]">
          <TextTrack
            text="INDIAN SCHOOL MULADHA"
            className="text-[12rem] font-display font-bold leading-none uppercase"
            direction="left"
          />
          <TextTrack
            text="ESTABLISHED 1981"
            className="text-[12rem] font-display font-bold leading-none uppercase"
            direction="right"
          />
        </div>

        {/* Futuristic Background Elements: Floating ambient orbs */}
        <div className="absolute inset-0 z-0 pointer-events-none overflow-hidden">
          <FuturisticElement className="top-[-10%] left-[-10%] w-96 h-96" delay={0} speed={15} />
          <FuturisticElement className="bottom-[-10%] right-[-10%] w-[500px] h-[500px]" delay={2} speed={25} />
          <FuturisticElement className="top-1/3 left-1/2 -translate-x-1/2 w-64 h-64" delay={5} speed={18} />
        </div>

        <div className="container relative z-10">
          <h2 className="sr-only">The school at a glance</h2>
          <dl className="register">
            {GLANCE.map((fact) => (
              <div key={fact.label} className="register__cell">
                <dt className="sr-only">{fact.label}</dt>
                <dd>
                  <CountUp
                    value={parseInt(fact.value.replace(/[^0-9]/g, '')) || 0}
                    className="register__value"
                  />
                  <span className="register__label block">{fact.label}</span>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      {/* ------------------------------------------------------ news + notices
          Stories lead, because a school site's most-checked content is what
          happened this week. The notice board sits beside them for the dated
          circulars that don't warrant a photograph. */}
      {posts.length > 0 && (
        <section className="snap-section flex flex-col pb-16 pt-32 md:pb-24 md:pt-36">
          <div className="container">
            <div className="section-head">
              <h2 className="text-2xl md:text-3xl">News and events</h2>
              <Link to="/news" className="link text-sm font-semibold">
                All news and circulars
              </Link>
            </div>

            <div className="mt-10 grid gap-12 lg:grid-cols-[2.1fr_1fr] lg:gap-16">
              <div className="grid gap-10 sm:grid-cols-3">
                {lead.map((post) => (
                  <article key={post.id}>
                    <Link to={`/news/${post.slug}`} className="group block">
                      <div className="story__media">
                        <Media src={post.coverUrl} alt={post.title} fallback="No image" />
                      </div>
                      <p className="story__cat">{CATEGORY_LABEL[post.category]}</p>
                      <h3 className="story__title">{post.title}</h3>
                      <p className="story__excerpt">{post.excerpt}</p>
                      <p className="story__meta">
                        <time dateTime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
                      </p>
                    </Link>
                  </article>
                ))}
              </div>

              {notices.length > 0 && (
                <div className="glass p-6">
                  <p className="rule-label">Recent circulars</p>
                  <ul className="notice-board mt-4">
                    {notices.map((post, i) => (
                      <li
                        key={post.id}
                        className="stagger-in"
                        style={{ animationDelay: `${i * 45}ms` }}
                      >
                        <Link to={`/news/${post.slug}`} className="notice">
                          <span className="notice__date">
                            <time dateTime={post.publishedAt}>
                              {new Date(post.publishedAt).toLocaleDateString('en-GB', {
                                day: '2-digit',
                                month: 'short',
                              })}
                            </time>
                          </span>
                          <span>
                            <span className="notice__title">{post.title}</span>
                            <span className="notice__meta">
                              {CATEGORY_LABEL[post.category]}
                            </span>
                          </span>
                        </Link>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        </section>
      )}

      {/* ------------------------------------------------------- the programmes */}
      {settings.k12Programs.length > 0 && (
        <section className="snap-section band band-line section-lg flex flex-col justify-center">
          <div className="container">
            <div className="section-head">
              <h2 className="text-2xl md:text-3xl">
                {settings.k12Heading || 'Kindergarten to Grade 12'}
              </h2>
              <Link to="/academics" className="link text-sm font-semibold">
                Academics in full
              </Link>
            </div>
            <p className="body-copy mt-6">
              Each stage is built on the one before it, so a student who joins in Kindergarten
              never meets a seam.
            </p>
            <ProgramLadder programs={settings.k12Programs} />
          </div>
        </section>
      )}

      {/* ------------------------------------------------ campus band + principal
          The one full-bleed photograph in the body of the page.
          The
          principal's message sits on it, because a signed message from a named
          person is the most institutional thing a school can put on a
          homepage. */}
      <PrincipalMessage
        message={settings.principalMessage}
        name={settings.principalName}
        title={settings.principalTitle}
        imageUrl={settings.campusImageUrl || settings.principalImageUrl}
      />

      {/* ------------------------------------------------------------- welcome
          Top-anchored, matching "news and events" above — a page of
          sections, so scrolling settles on one at a time. */}
      <section className="snap-section band band-line flex flex-col pb-16 pt-32 md:pb-24 md:pt-36">
        <div className="container grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
          <div>
            <h2 className="text-2xl md:text-3xl">
              {settings.welcomeHeading || 'Forty-four years in Al Muladha'}
            </h2>
            <div className="cms-prose mt-6">{settings.welcomeBody}</div>
            <Link to="/about" className="btn-outline mt-8">
              About the school
            </Link>
          </div>
          <div className="spotlight-card relative aspect-[4/3] overflow-hidden bg-paper-band">
            <Media
              src={settings.welcomeImageUrl}
              alt={`${settings.siteName} campus`}
              fallback="No image"
            />
          </div>
        </div>
      </section>

      {/* ------------------------------------------------------------- gallery */}
      {settings.experienceImages.length > 0 && (
        <section className="snap-section section-lg flex flex-col justify-center">
          <div className="container">
            <div className="section-head">
              <h2 className="text-2xl md:text-3xl">
              {settings.experienceHeading || 'Life on sixteen acres'}
              </h2>
              <Link to="/gallery" className="link text-sm font-semibold">
                Full photo gallery
              </Link>
            </div>
            {settings.experienceBody && <p className="body-copy mt-6">{settings.experienceBody}</p>}

            <ul className="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4">
              {settings.experienceImages.slice(0, 8).map((img) => (
                <li key={img.id}>
                  <figure>
                    <div className="spotlight-card relative aspect-[4/3] overflow-hidden bg-paper-band">
                      <Media
                      src={img.url}
                      alt={img.caption ?? `${settings.siteName} campus`}
                      fallback="No image"
                      />
                    </div>
                    {img.caption && (
                      <figcaption className="mt-2 text-xs text-ink-muted">
                      {img.caption}
                      </figcaption>
                    )}
                  </figure>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      {/* --------------------------------------------------- tour + resources
          Same top-anchored rhythm as the twoes sections above — the page's
          last "plain" beat before the footer.
          */}
      <section className="snap-section band band-line flex flex-col pb-16 pt-32 md:pb-24 md:pt-36">
        <div className="container grid gap-10 md:grid-cols-2 md:gap-14">
          <div>
            <h2 className="text-xl">{settings.tourHeading || 'Take a virtual tour'}</h2>
            <p className="body-copy mt-4">{settings.tourBody}</p>
            {/^https?:\/\//.test(settings.tourLink) && (
              <a href={settings.tourLink} className="btn-primary mt-7">
                Walk the campus
              </a>
            )}
          </div>
          <div className="md:border-l md:border-paper-line md:pl-14">
            <h2 className="text-xl">Students resources</h2>
            <p className="body-copy mt-4">
              Time table, syllabus, homework and CBSE results for the current session, in one
              place.
            </p>
            <Link to="/students" className="btn-outline mt-7">
              Open resources
            </Link>
          </div>
        </div>
      </section>
    </>
  );
}
